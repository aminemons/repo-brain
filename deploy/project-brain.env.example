# Copy this file to project-brain.env and keep it private. Generate secrets with:
# openssl rand -hex 32

# Required deployment values
PUBLIC_DOMAIN=brain.example.com
PROJECT_REPO_PATH=/srv/project-brain/repository
DOCUMENTATION_PATH=/srv/project-brain/repository/docs
POSTGRES_USER=project_brain
POSTGRES_DB=project_brain
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_SECRET
CODEWIKI_AUTH_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_HEX_SECRET
POSTGRES_IMAGE=pgvector/pgvector:PIN_A_TESTED_PG16_TAG
CADDY_IMAGE=caddy:PIN_A_TESTED_VERSION

# Optional read-only Bearer token for the viewer role
CODEWIKI_VIEWER_TOKEN=

# Keep local-only enabled. Hostnames must match the configured local inference
# service and CODEWIKI_LOCAL_LLM_HOSTS exactly.
CODEWIKI_LOCAL_ONLY=true
CODEWIKI_PRIVACY_MODE=local_only
CODEWIKI_EXTERNAL_EXCERPT_MAX_CHARS=16000
CODEWIKI_LOCAL_LLM_HOSTS=localhost,127.0.0.1,::1,ollama,vllm,litellm

# Leave model fields empty until the OVH hardware and a local model are measured.
# For the optional Ollama profile, set the endpoint to http://ollama:11434 and
# configure a model identifier supported by the installed CodeWiki/LiteLLM version.
CODEWIKI_LLM__DEFAULT__MODEL=
CODEWIKI_LLM__DEFAULT__PROVIDER_TYPE=
CODEWIKI_LLM__DEFAULT__ENDPOINT=
CODEWIKI_LLM__DEFAULT__API_KEY=
CODEWIKI_LLM__TIMEOUT_SECONDS=120
CODEWIKI_LLM__MAX_RETRIES=2
CODEWIKI_LLM__CACHE_ENABLED=true

# Required by the optional `--profile ollama` service. Pin a version tested on
# the target host; do not use latest for a production deployment.
OLLAMA_IMAGE=ollama/ollama:PIN_A_TESTED_VERSION
