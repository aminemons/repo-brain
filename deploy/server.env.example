# The setup script creates a private deploy/server.env with a random owner token.
CODEWIKI_AUTH_TOKEN=
APP_PORT=8000
APP_MEMORY_LIMIT=2g
APP_CPU_LIMIT=2
MODEL_MEMORY_LIMIT=1400m
MODEL_CPU_LIMIT=2
NAJM_MEMORY_LIMIT=512m
NAJM_CPU_LIMIT=1
# Optional: GitHub token scoped to the repositories the app should access.
# Contents write and pull requests write are needed to publish bot changes.
GH_TOKEN=
# Optional HTTPS hostname; leave blank when using an SSH tunnel.
PUBLIC_DOMAIN=
